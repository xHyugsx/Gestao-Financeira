<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_fundo" android:padding="14dp">
    <TextView android:id="@+id/titulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FINANÇAS" android:textSize="11sp" android:letterSpacing="0.1" android:textColor="#9AA0C8" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:orientation="vertical" android:background="@drawable/widget_bloco" android:padding="10dp">
            <TextView android:id="@+id/rend_rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rendimento" android:textSize="11sp" android:textColor="#9AA0C8" android:maxLines="1" />
            <TextView android:id="@+id/rendimento" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="18sp" android:textStyle="bold" android:textColor="#EEF0FF" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical" android:background="@drawable/widget_bloco" android:padding="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gastos do mês" android:textSize="11sp" android:textColor="#9AA0C8" />
            <TextView android:id="@+id/gastos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="18sp" android:textStyle="bold" android:textColor="#FB7F6F" android:maxLines="1" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/p0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="3dp" android:text="○" android:textSize="11sp" android:textColor="#55FFFFFF" /><TextView android:id="@+id/p1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="3dp" android:text="○" android:textSize="11sp" android:textColor="#55FFFFFF" /><TextView android:id="@+id/p2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="3dp" android:text="○" android:textSize="11sp" android:textColor="#55FFFFFF" /><TextView android:id="@+id/p3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="3dp" android:text="○" android:textSize="11sp" android:textColor="#55FFFFFF" /><TextView android:id="@+id/p4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="3dp" android:text="○" android:textSize="11sp" android:textColor="#55FFFFFF" /><TextView android:id="@+id/p5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="3dp" android:text="○" android:textSize="11sp" android:textColor="#55FFFFFF" /><TextView android:id="@+id/p6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="3dp" android:text="○" android:textSize="11sp" android:textColor="#55FFFFFF" /></LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <TextView android:id="@+id/bt_mais" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:gravity="center" android:background="@drawable/widget_botao_mais" android:text="+ Despesa" android:textStyle="bold" android:textSize="13sp" android:textColor="#F7C75B" />
        <TextView android:id="@+id/bt_jarvis" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:background="@drawable/widget_botao" android:text="Jarvis" android:textStyle="bold" android:textSize="13sp" android:textColor="#EEF0FF" />
    </LinearLayout>
</LinearLayout>
